// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

enum Visibility {
  public
  private
}

model Song {
  playlistId Int
  order Int @default(autoincrement())
  name String @id
  artist String
  year Int?
  genre String?
  link String
  Playlist Playlist @relation(fields: [playlistId], references: [id])
}

model Playlist {
  id Int @id @default(autoincrement())
  name String
  category String
  visibility Visibility @default(public)
  songs Song[]
  numSongs Int
  likes Int @default(0)
}
